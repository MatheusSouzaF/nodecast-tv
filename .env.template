# Copie este arquivo para .env e preencha os valores reais.
# cp .env.template .env

# Porta publicada no host (mapeada para a porta interna 3000 do container)
NODECAST_PORT=8083

# Ambiente do Node
NODE_ENV=production

# Segredo usado para assinar os JWTs de sessao e o cookie de sessao do
# fluxo OIDC. Gere um valor aleatorio, ex: openssl rand -hex 32
JWT_SECRET=troque_por_um_valor_aleatorio

# --- SSO / OIDC (opcional) ---
# Deixe as tres variaveis abaixo vazias/comentadas para manter o SSO
# desabilitado (login local continua funcionando normalmente).
# Preencha com os dados gerados no seu provedor (Authentik, Keycloak, etc.)
# para habilitar "Entrar com SSO".
#OIDC_ISSUER_URL=https://your-idp.com/application/o/nodecast/
#OIDC_CLIENT_ID=your_client_id
#OIDC_CLIENT_SECRET=your_client_secret
#OIDC_CALLBACK_URL=http://s2.spanador-vector.ts.net:8083/api/auth/oidc/callback

# Opcionais: so necessarios se as URLs do provedor nao seguirem o padrao
# OIDC_ISSUER_URL + /protocol/openid-connect/{auth,token,userinfo}
# (padrao Keycloak). Para outros provedores (ex: Authentik), informe
# explicitamente.
#OIDC_AUTH_URL=
#OIDC_TOKEN_URL=
#OIDC_USERINFO_URL=
